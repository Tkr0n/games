---
import Breadcrumbs from '../../../../components/astro/Breadcrumbs.astro';
import PriceDisplay from '../../../../components/react/PriceDisplay.tsx';
import { getDictionary, isLocale } from '../../../../i18n/utils';
import {
  createServerApiClient,
  isValidExternalId,
  isValidUuid,
  resolveClientIp,
  resolveServerEnv,
} from '../../../../lib/api-client';
import { getRegionMeta } from '../../../../lib/regions';
import { buildBreadcrumbJsonLd, normalizeSiteUrl, sanitizeExternalImageUrl } from '../../../../lib/seo';
import BaseLayout from '../../../../layouts/BaseLayout.astro';

const { lang, providerUid, id } = Astro.params;

if (!isLocale(lang) || !isValidUuid(providerUid) || !isValidExternalId(id)) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}

const locale = lang;
const t = getDictionary(locale);

const siteUrl = normalizeSiteUrl(Astro.site?.toString() ?? Astro.url.origin);
const client = createServerApiClient(resolveServerEnv(Astro.locals), {
  clientIp: resolveClientIp(Astro.request),
});

const [categoriesResult, itemsResult, requirementsResult, ratesResult] = await Promise.all([
  client.getCategories({ providerUid }),
  client.getItems({ providerUid, categoryId: id, page: 1, pageSize: 48 }),
  client.getCategoryRequirements(providerUid, id),
  client.getRates(),
]);

const rates = ratesResult.ok ? ratesResult.data : null;
const categories = categoriesResult.ok ? categoriesResult.data : [];
const items = itemsResult.ok ? itemsResult.data.items : [];
const requirements = requirementsResult.ok ? requirementsResult.data : [];

const category = categories.find(
  (candidate) => candidate.providerUid === providerUid && candidate.externalId === id,
);
const itemsUnavailable = !itemsResult.ok;

const categoryName = category?.name ?? items[0]?.categoryName ?? id;
const categoryDescription = category?.description ?? '';

const REGION_TOKEN_PATTERN =
  /\b(usa|us|global|worldwide|international|mexico|méxico|panama|panamá|colombia|mx|pa|co)\b/gi;

function normalizeTitle(value: string): string {
  return value
    .replace(REGION_TOKEN_PATTERN, ' ')
    .replace(/[()[\]{}]/g, ' ')
    .replace(/[-–—|:/]+/g, ' ')
    .replace(/\s+/g, ' ')
    .trim()
    .toLowerCase();
}

const baseTitle = normalizeTitle(categoryName);
const relatedCategories = baseTitle
  ? categories.filter(
      (candidate) =>
        candidate.providerUid === providerUid &&
        candidate.externalId !== id &&
        normalizeTitle(candidate.name) === baseTitle,
    )
  : [];

const categoryPath = `/${locale}/category/${encodeURIComponent(providerUid)}/${encodeURIComponent(id)}`;
const title = `${categoryName} · ${t.meta.siteName}`;
const description = (categoryDescription || t.catalog.subtitle).slice(0, 160);

const jsonLd = [
  buildBreadcrumbJsonLd(siteUrl, [
    { name: t.nav.home, path: `/${locale}` },
    { name: t.catalog.title, path: `/${locale}/catalog` },
    { name: categoryName, path: categoryPath },
  ]),
];
---

<BaseLayout
  locale={locale}
  title={title}
  description={description}
  pathname={Astro.url.pathname}
  siteUrl={siteUrl}
  jsonLd={jsonLd}
  initialRates={rates}
>
  <div class="space-y-6">
    <Breadcrumbs
      locale={locale}
      items={[
        { name: t.nav.home, href: `/${locale}/` },
        { name: t.catalog.title, href: `/${locale}/catalog` },
        { name: categoryName },
      ]}
    />

    <header class="verkku-surface space-y-3 p-5 sm:p-6">
      <div class="flex flex-wrap items-center gap-2">
        {
          category ? (
            <span class="rounded-full border border-verkku-neon/40 bg-verkku-neon/10 px-2.5 py-1 text-[11px] font-semibold text-verkku-mint">
              {t.product.regionLabel}: {getRegionMeta(category.region, locale).label}
            </span>
          ) : null
        }
        <span class="rounded-full border border-verkku-mint-soft/35 bg-verkku-bg-deep/60 px-2.5 py-1 text-[11px] font-semibold text-verkku-stone">
          {t.catalog.filters.resultsLabel}: {items.length}
        </span>
      </div>

      <h1 class="font-display text-3xl font-extrabold text-verkku-light sm:text-4xl">{categoryName}</h1>
      {
        categoryDescription ? (
          <p class="max-w-3xl text-sm leading-relaxed text-verkku-stone">{categoryDescription}</p>
        ) : null
      }
    </header>

    {
      itemsUnavailable ? (
        <section role="alert" class="verkku-surface space-y-3 border-verkku-mint-soft/25 p-6">
          <h2 class="font-display text-lg font-bold text-verkku-light">{t.errors.apiUnavailableTitle}</h2>
          <p class="max-w-prose text-sm leading-relaxed text-verkku-stone">
            {t.errors.apiUnavailableBody}
          </p>
          <a
            href={`${Astro.url.pathname}${Astro.url.search}`}
            class="inline-flex rounded-lg bg-verkku-green px-4 py-2 text-sm font-semibold text-verkku-light transition-colors hover:bg-verkku-emerald focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-verkku-neon"
          >
            {t.common.retry}
          </a>
        </section>
      ) : null
    }

    {
      relatedCategories.length > 0 ? (
        <section class="verkku-surface space-y-2 p-5">
          <h2 class="font-display text-base font-bold text-verkku-light">{t.product.crossRegionTitle}</h2>
          <p class="text-xs leading-relaxed text-verkku-stone">{t.product.crossRegionHint}</p>
          <ul class="flex flex-wrap gap-2">
            {relatedCategories.map((related) => {
              const meta = getRegionMeta(related.region, locale);

              return (
                <li>
                  <a
                    href={`/${locale}/category/${encodeURIComponent(related.providerUid)}/${encodeURIComponent(related.externalId)}`}
                    class="inline-flex items-center gap-2 rounded-lg border border-verkku-mint-soft/30 bg-verkku-bg-deep/60 px-3 py-1.5 text-xs font-semibold text-verkku-stone transition-colors hover:border-verkku-neon/60 hover:text-verkku-light focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-verkku-neon"
                  >
                    <span class="rounded-full bg-verkku-surface px-2 py-0.5 text-[10px] font-bold tracking-wide text-verkku-mint">
                      {meta.shortLabel}
                    </span>
                    {related.name}
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      ) : null
    }

    {
      requirements.length > 0 ? (
        <section class="verkku-surface space-y-2 p-5">
          <h2 class="font-display text-base font-bold text-verkku-light">{t.product.requirementsTitle}</h2>
          <p class="text-xs leading-relaxed text-verkku-stone">{t.product.requirementsHint}</p>
          <ul class="space-y-2">
            {requirements.map((requirement) => (
              <li class="rounded-lg border border-verkku-mint-soft/25 bg-verkku-bg-deep/50 p-3">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <span class="font-mono text-xs font-semibold text-verkku-light">{requirement.fieldName}</span>
                  <span class="rounded-full border border-verkku-mint-soft/35 px-2 py-0.5 font-mono text-[11px] text-verkku-mint-soft">
                    {requirement.dataType}
                  </span>
                </div>
                {requirement.placeholder ? (
                  <p class="mt-1 text-xs text-verkku-stone">{requirement.placeholder}</p>
                ) : null}
                {requirement.selectOptions.length > 0 ? (
                  <ul class="mt-2 flex flex-wrap gap-1.5">
                    {requirement.selectOptions.map((option) => (
                      <li class="rounded-md border border-verkku-mint-soft/30 bg-verkku-surface px-2 py-0.5 text-[11px] text-verkku-stone">
                        {option}
                      </li>
                    ))}
                  </ul>
                ) : null}
              </li>
            ))}
          </ul>
        </section>
      ) : null
    }

    {
      items.length > 0 ? (
        <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {items.map((item) => {
            const regionMeta = getRegionMeta(item.region, locale);
            const typeLabel =
              item.productType === 'topup'
                ? t.product.productTypeTopup
                : t.product.productTypeVoucher;

            return (
              <li class="h-full">
                <a
                  href={`/${locale}/product/${encodeURIComponent(item.providerUid)}/${encodeURIComponent(item.externalId)}`}
                  class="group flex h-full flex-col overflow-hidden rounded-xl border border-verkku-mint-soft/20 bg-verkku-surface/90 transition-colors hover:border-verkku-neon/50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-verkku-neon"
                >
                  <div class="relative aspect-[4/3] overflow-hidden bg-verkku-bg-deep">
                    <img
                      src={sanitizeExternalImageUrl(item.imageUrl)}
                      alt={item.name}
                      loading="lazy"
                      decoding="async"
                      referrerpolicy="no-referrer"
                      width="480"
                      height="360"
                      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03] motion-reduce:transform-none"
                    />
                  </div>

                  <div class="flex flex-1 flex-col gap-2 p-4">
                    <h2 class="text-sm font-semibold leading-snug text-verkku-light">{item.name}</h2>

                    <div class="flex flex-wrap gap-1.5">
                      <span class="rounded-full border border-verkku-neon/40 bg-verkku-neon/10 px-2 py-0.5 text-[11px] font-semibold text-verkku-mint">
                        {regionMeta.shortLabel}
                      </span>
                      <span class="rounded-full border border-verkku-mint-soft/35 bg-verkku-bg-deep/60 px-2 py-0.5 text-[11px] font-semibold text-verkku-stone">
                        {typeLabel}
                      </span>
                      <span class="rounded-full border border-verkku-mint-soft/35 bg-verkku-bg-deep/60 px-2 py-0.5 text-[11px] font-semibold text-verkku-stone">
                        {item.inStock ? t.product.inStock : t.product.outOfStock}
                      </span>
                    </div>

                    <div class="mt-auto pt-2">
                      <PriceDisplay
                        client:visible
                        locale={locale}
                        amountUsd={item.retailPriceUsd?.amount ?? null}
                        pricesLocked={item.pricesLocked}
                        initialRates={rates}
                        showFrom
                        size="sm"
                      />
                    </div>
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
      ) : !itemsUnavailable ? (
        <section class="verkku-surface space-y-2 p-6">
          <h2 class="font-display text-lg font-bold text-verkku-light">{t.catalog.emptyTitle}</h2>
          <p class="max-w-prose text-sm leading-relaxed text-verkku-stone">{t.catalog.emptyBody}</p>
          <a
            href={`/${locale}/catalog`}
            class="inline-flex rounded-lg border border-verkku-mint-soft/30 bg-verkku-surface px-4 py-2 text-sm font-semibold text-verkku-stone transition-colors hover:border-verkku-neon/60 hover:text-verkku-light focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-verkku-neon"
          >
            {t.product.backToCatalog}
          </a>
        </section>
      ) : null
    }

    <a
      href={`/${locale}/catalog`}
      class="inline-flex items-center gap-1 text-sm font-semibold text-verkku-mint underline decoration-verkku-mint/50 underline-offset-4 transition-colors hover:text-verkku-light focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-verkku-neon"
    >
      <span aria-hidden="true">←</span>
      {t.product.backToCatalog}
    </a>
  </div>
</BaseLayout>
