# Backend (.NET 10) Environment Variables Example
# Prefer `dotnet user-secrets` in local development; use env vars in Raspberry Pi / Docker.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5180

# Internal BFF authentication key (required for all /api/v1/* routes)
ApiSecurity__ClientApiKey=change_me_local_dev_bff_key_32bytes
# Comma-separated or indexed CORS origins (empty in Production since Cloudflare SSR is server-to-server)
ApiSecurity__AllowedOrigins__0=http://localhost:4321

# SHOP2TOPUP Reseller API v1 credentials
Shop2TopUp__BaseUrl=https://shop2topup.com/api/endpoints/v1
Shop2TopUp__KeyId=your_shop2topup_key_id
Shop2TopUp__KeySecret=your_shop2topup_key_secret
Shop2TopUp__ProviderUid=d4f8a2c1-7b3e-4f90-9a12-6e8b5c3d1f42

# Binance public market-data endpoint (no API key required)
Binance__BaseUrl=https://data-api.binance.vision

# Pricing configuration (USD base; MinimumMarginUsd acts as a floor unless category override is 0)
Pricing__DefaultMarkupPercent=10.0
Pricing__MinimumMarginUsd=0.25

# Redis / Valkey connection string
Cache__RedisConnectionString=localhost:6379,password=change_me_local_dev_only,abortConnect=false
Cache__KeyPrefix=verkkugames:v1:
