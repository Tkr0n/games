# ==============================================================================
# Verkku Games — Root Environment Variables Example
# Copy to .env for local docker-compose usage. NEVER commit real secrets.
# ==============================================================================

# Redis (cache — StackExchangeRedis / HybridCache L2)
REDIS_PASSWORD=verkkugames_dev_redis

# PostgreSQL (reserved for v2 transactional store: orders, users, payments)
POSTGRES_USER=verkkugames
POSTGRES_PASSWORD=verkkugames_dev_postgres
POSTGRES_DB=verkkugames
POSTGRES_PORT=5432

# Backend API internal client key (shared between Astro Cloudflare Worker BFF and .NET API)
API_CLIENT_KEY=change_me_generate_32_byte_random_hex

# SHOP2TOPUP Reseller API v1 credentials (obtain from SHOP2TOPUP Reseller Panel -> API Access)
SHOP2TOPUP_KEY_ID=your_shop2topup_key_id
SHOP2TOPUP_KEY_SECRET=your_shop2topup_key_secret
SHOP2TOPUP_PROVIDER_UID=d4f8a2c1-7b3e-4f90-9a12-6e8b5c3d1f42

# Pricing policy (USD base; MinimumMarginUsd acts as a floor unless category override is 0)
PRICING_DEFAULT_MARKUP_PERCENT=10.0
PRICING_MINIMUM_MARGIN_USD=0.25

# Frontend public site URL (used for SEO canonical, hreflang, robots.txt, sitemap.xml)
PUBLIC_SITE_URL=https://games.verkku.com
API_BASE_URL=http://localhost:5180
