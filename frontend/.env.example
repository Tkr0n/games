# Frontend (Astro 5 SSR on Cloudflare Workers) Environment Variables Example
# For local dev with `bun run dev`, copy to `.env` or `.dev.vars`.
# In Cloudflare Workers production, set API_CLIENT_KEY via `wrangler secret put API_CLIENT_KEY`.

# Public site URL (used for canonical, hreflang, OpenGraph, robots.txt, sitemap.xml)
PUBLIC_SITE_URL=https://games.verkku.com

# Private server-only backend API URL & internal BFF key (NEVER prefix with PUBLIC_)
API_BASE_URL=http://localhost:5180
API_CLIENT_KEY=change_me_local_dev_bff_key_32bytes
